# --- Admin portal (all required for /admin to work; the public site works without them) ---
# Any PostgreSQL connection string. On Vercel: Storage -> Create Database -> Neon (sets this for you).
DATABASE_URL=
# Random secret, 32+ characters, used to sign login sessions. Generate: openssl rand -base64 48
AUTH_SECRET=
# First administrator, created once on first start. You are forced to change the password at first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional, lost-password recovery: set a new temporary value, redeploy, sign in, change it, then delete the variable.
# ADMIN_RECOVERY_PASSWORD=
